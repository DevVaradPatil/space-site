rules_version = '2';

// Paste into Firebase console → Firestore → Rules (project: stellar-explorers).
// Anyone can read team/activities; only accounts listed in /admins can change them.
// /admins itself is managed from the console only.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /team/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
